<UserControl x:Class="PhotoMaker.Client.Components.ThresholdTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PhotoMaker.Client.Components"
             xmlns:behaviors="clr-namespace:PhotoMaker.Client.Infrastructure.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:b="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
             xmlns:oxyWpf="http://oxyplot.org/wpf"
             d:DesignHeight="450" d:DesignWidth="800"
>
        <!--  Контент  -->
        <Border BorderBrush="Gray" Height="Auto" Background="WhiteSmoke" BorderThickness="0.7" CornerRadius="3">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--  Информационные параметры бинаризации  -->
                <DockPanel Grid.Row="0" HorizontalAlignment="Left">
                    <Grid DockPanel.Dock="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Вкл/выкл: " FontWeight="DemiBold" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding ThresholdToolVM.IsThresholdToolOn}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid DockPanel.Dock="Right" Visibility="{Binding ThresholdToolVM.ThresholdToolVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Threshold: " VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ThresholdToolVM.Threshold, Mode=OneWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Width="60"/>
                </DockPanel>

                <!--  Гистограмма распределения пикселей для бинаризации  -->
            <Border Grid.Row="1" BorderBrush="LightSlateGray" Margin="0,10,0,0" Height="Auto" Background="WhiteSmoke" BorderThickness="1.5" CornerRadius="3" Visibility="{Binding ThresholdToolVM.ThresholdToolVisibility}">
                <oxyWpf:PlotView x:Name="ThresholdPlot" Model="{Binding ThresholdToolVM.PixelHistogramPlot}" DefaultTrackerTemplate="{x:Null}" Height="251">
                        <i:Interaction.Behaviors>
                            <behaviors:ThresholdToolVisorBehavior
                                    StartDragVisorCommand="{Binding ThresholdToolVM.StartDragVisorCommand}"
                                    DragVisorCommand="{Binding ThresholdToolVM.DragVisorCommand}"
                                    EndDragVisorCommand="{Binding ThresholdToolVM.EndDragVisorCommand}"
                            />
                    </i:Interaction.Behaviors>
                    </oxyWpf:PlotView>
                </Border>
            </Grid>
        </Border>
</UserControl>

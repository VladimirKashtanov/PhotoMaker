<UserControl x:Class="PhotoMaker.Client.Components.CurvesTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PhotoMaker.Client.Components"
             xmlns:behaviors="clr-namespace:PhotoMaker.Client.Infrastructure.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:b="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
             xmlns:oxyWpf="http://oxyplot.org/wpf"
             d:DesignWidth="440"
>
    <!--  Контент  -->
    <Border BorderBrush="Gray" Height="Auto" Background="WhiteSmoke" BorderThickness="0.7" CornerRadius="3">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="251"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="251"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1"/>

            <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="1.5" CornerRadius="3" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <Grid Grid.Column="0" ShowGridLines="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="15"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="Silver" BorderThickness="0" >
                            <Border.Background >
                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                    <GradientStop Color="Black" Offset="0"/>
                                    <GradientStop Color="White" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Border Grid.Row="1" Background="Black" BorderThickness="0"/>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="15"/>
                        </Grid.RowDefinitions>

                        <!--  График сплайна  -->
                        <Border Grid.Row="0" BorderThickness="0">
                            <oxyWpf:PlotView Model="{Binding CurvesToolVM.GradationCurvePlot}" DefaultTrackerTemplate="{x:Null}">
                                <i:Interaction.Behaviors>
                                    <behaviors:GradationCurveDragBehavior
                                    StartDragGradationCurveCommand="{Binding CurvesToolVM.StartDragGradationCurveCommand}"
                                    DragGradationCurveCommand="{Binding CurvesToolVM.DragGradationCurveCommand}"
                                    EndDragGradationCurveCommand="{Binding CurvesToolVM.EndDragGradationCurveCommand}"
                                    RemoveNodeCommand="{Binding CurvesToolVM.RemoveNodeCommand}"
                                />
                                </i:Interaction.Behaviors>
                            </oxyWpf:PlotView>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.Background >
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="Black" Offset="0"/>
                                    <GradientStop Color="White" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!--  Гистограмма распределения пикселей  -->
            <Border Grid.Row="2" BorderBrush="LightSlateGray" BorderThickness="1.5" CornerRadius="3" ClipToBounds="True">
                <oxyWpf:PlotView Model="{Binding CurvesToolVM.PixelHistogramPlot}" DefaultTrackerTemplate="{x:Null}"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
